// NyayVakil – Prisma Schema
// Database: PostgreSQL (Supabase)
//
// Conventions:
// - Every tenant-owned row carries firmId; services always filter by it.
// - Money is Decimal(12,2). Calendar dates (hearing day, due date, …) are @db.Date
//   and travel as "YYYY-MM-DD" strings, so they never shift across timezones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  advocate
  junior
  clerk
  admin
}

enum ClientType {
  individual
  company
  family
  organization
}

enum MatterStatus {
  active
  pending
  disposed
  on_hold
  closed
}

enum MatterPriority {
  high
  medium
  low
}

enum CourtLevel {
  supreme_court
  high_court
  district_court
  sessions_court
  magistrate_court
  family_court
  consumer_court
  tribunal
  other
}

enum HearingStatus {
  upcoming
  attended
  adjourned
  completed
  missed
}

enum FeeStatus {
  paid
  partially_paid
  overdue
  not_started
}

enum PaymentMethod {
  cash
  bank_transfer
  cheque
  upi
  other
}

enum ExpenseType {
  court_fee
  clerk_expense
  photocopy
  typing
  travel
  affidavit
  filing
  stamp
  miscellaneous
}

enum DocumentCategory {
  vakalatnama
  affidavit
  notice
  petition
  written_statement
  evidence
  receipt
  invoice
  id_proof
  court_order
  miscellaneous
}

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled
}

enum TaskPriority {
  high
  medium
  low
}

enum ReminderType {
  hearing
  payment
  document
  follow_up
  general
}

enum ReminderStatus {
  pending
  sent
  acknowledged
  cancelled
}

enum ReminderChannel {
  whatsapp
  sms
  email
  internal
}

enum TimelineEventType {
  created
  hearing_added
  payment_logged
  expense_added
  document_uploaded
  reminder_created
  task_completed
  status_changed
  note_added
  hearing_completed
}

enum SubscriptionPlan {
  free
  solo
  chamber
  firm
}

enum SubscriptionStatus {
  trialing
  active
  expired
  cancelled
  suspended
}

// ─────────────────────────────────────────────
// FIRM
// ─────────────────────────────────────────────

model Firm {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  sessions          Session[]
  clients           Client[]
  matters           Matter[]
  hearings          Hearing[]
  feeEntries        FeeEntry[]
  payments          Payment[]
  expenses          Expense[]
  documents         Document[]
  tasks             Task[]
  reminders         Reminder[]
  timelineEntries   TimelineEntry[]
  reminderTemplates ReminderTemplate[]
  caseTypes         CaseType[]
  officeSettings    OfficeSettings?
  subscription      Subscription?

  @@map("firms")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  passwordHash     String
  phone            String   @unique
  role             UserRole @default(advocate)
  avatar           String?
  barCouncilNumber String?
  specialization   String[]
  chamberName      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  firmId String

  firm             Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  sessions         Session[]
  matters          Matter[]        @relation("CreatedByUser")
  assignedMatters  Matter[]        @relation("AssignedJunior")
  clerkMatters     Matter[]        @relation("AssignedClerk")
  assignedTasks    Task[]          @relation("AssignedToUser")
  createdTasks     Task[]          @relation("AssignedByUser")
  assignedHearings Hearing[]       @relation("HearingAssignee")
  uploadedDocs     Document[]      @relation("DocumentUploader")
  timeline         TimelineEntry[]

  @@index([firmId])
  @@map("users")
}

// ─────────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────────

model Session {
  id         String   @id @default(cuid())
  // SHA-256 of the cookie token; the raw token is never stored
  tokenHash  String   @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  userId String
  firmId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// LOGIN ATTEMPT (brute-force protection)
// ─────────────────────────────────────────────

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  ipAddress  String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

// ─────────────────────────────────────────────
// LEAD (website enquiries: demo bookings, contact form, callback requests)
// ─────────────────────────────────────────────

model Lead {
  id           String    @id @default(cuid())
  kind         String // "demo" | "contact" | "callback"
  name         String
  mobile       String
  email        String?
  organisation String?
  message      String?
  // Everything else the form collected (practice type, preferred slot, …)
  details      Json?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  handledAt    DateTime?

  @@index([createdAt])
  @@index([ipAddress, createdAt])
  @@map("leads")
}

// ─────────────────────────────────────────────
// SUBSCRIPTION
// ─────────────────────────────────────────────

model Subscription {
  id                 String             @id @default(cuid())
  plan               SubscriptionPlan   @default(free)
  status             SubscriptionStatus @default(trialing)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  razorpaySubId      String?
  razorpayCustomerId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  firmId String @unique

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─────────────────────────────────────────────
// CLIENT
// ─────────────────────────────────────────────

model Client {
  id              String     @id @default(cuid())
  name            String
  mobile          String
  alternateMobile String?
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  clientType      ClientType @default(individual)
  notes           String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  firmId String

  firm       Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matters    Matter[]
  feeEntries FeeEntry[]
  payments   Payment[]
  expenses   Expense[]
  documents  Document[]
  tasks      Task[]
  reminders  Reminder[]
  timeline   TimelineEntry[]

  @@index([firmId, isActive])
  @@index([firmId, createdAt])
  @@map("clients")
}

// ─────────────────────────────────────────────
// MATTER (CASE)
// ─────────────────────────────────────────────

model Matter {
  id               String         @id @default(cuid())
  matterTitle      String
  caseNumber       String?
  cnrNumber        String?
  caseType         String
  courtName        String
  courtLevel       CourtLevel     @default(district_court)
  caseStage        String?
  filingDate       DateTime?      @db.Date
  // Kept in sync with the earliest upcoming hearing by the hearings service
  nextHearingDate  DateTime?      @db.Date
  oppositeParty    String?
  oppositeAdvocate String?
  advocateOnRecord String?
  status           MatterStatus   @default(active)
  priority         MatterPriority @default(medium)
  judgeName        String?
  policeStation    String?
  actSection       String?
  notes            String?
  // Fees paid and expenses are derived from payments/expenses, never stored here
  totalFeeAgreed   Decimal        @default(0) @db.Decimal(12, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  firmId           String
  clientId         String
  createdBy        String
  assignedJuniorId String?
  assignedClerkId  String?

  firm           Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id])
  creator        User            @relation("CreatedByUser", fields: [createdBy], references: [id])
  assignedJunior User?           @relation("AssignedJunior", fields: [assignedJuniorId], references: [id])
  assignedClerk  User?           @relation("AssignedClerk", fields: [assignedClerkId], references: [id])
  hearings       Hearing[]
  feeEntries     FeeEntry[]
  payments       Payment[]
  expenses       Expense[]
  documents      Document[]
  tasks          Task[]
  reminders      Reminder[]
  timeline       TimelineEntry[]

  @@index([firmId, status])
  @@index([firmId, clientId])
  @@index([firmId, createdAt])
  @@map("matters")
}

// ─────────────────────────────────────────────
// HEARING
// ─────────────────────────────────────────────

model Hearing {
  id               String        @id @default(cuid())
  // Court day of the hearing; time is local "HH:mm" as printed on the cause list
  date             DateTime      @db.Date
  time             String?
  // Overrides the matter's court (e.g. matter transferred to another court room)
  courtName        String?
  purpose          String?
  notes            String?
  nextAction       String?
  nextHearingDate  DateTime?     @db.Date
  appearanceStatus String?
  status           HearingStatus @default(upcoming)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  firmId       String
  matterId     String
  assignedToId String?

  firm       Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter     Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  assignedTo User?  @relation("HearingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([firmId, date])
  @@index([firmId, matterId])
  @@map("hearings")
}

// ─────────────────────────────────────────────
// FEE ENTRY
// ─────────────────────────────────────────────

model FeeEntry {
  id             String    @id @default(cuid())
  description    String
  totalAmount    Decimal   @db.Decimal(12, 2)
  // receivedAmount/pendingAmount are changed only by the payments service, atomically
  receivedAmount Decimal   @default(0) @db.Decimal(12, 2)
  pendingAmount  Decimal   @db.Decimal(12, 2)
  dueDate        DateTime? @db.Date
  // Stored as paid / partially_paid / not_started; "overdue" is derived when reading
  status         FeeStatus @default(not_started)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  firmId   String
  matterId String
  clientId String

  firm     Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter   Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  client   Client    @relation(fields: [clientId], references: [id])
  payments Payment[]

  @@index([firmId, status])
  @@index([firmId, matterId])
  @@index([firmId, clientId])
  @@map("fee_entries")
}

// ─────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(cash)
  paymentDate     DateTime      @db.Date
  referenceNumber String?
  receiptNumber   String?
  notes           String?
  createdAt       DateTime      @default(now())

  firmId     String
  feeEntryId String
  matterId   String
  clientId   String

  firm     Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  feeEntry FeeEntry @relation(fields: [feeEntryId], references: [id], onDelete: Cascade)
  matter   Matter   @relation(fields: [matterId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])

  @@index([firmId, paymentDate])
  @@index([firmId, matterId])
  @@index([feeEntryId])
  @@map("payments")
}

// ─────────────────────────────────────────────
// EXPENSE
// ─────────────────────────────────────────────

model Expense {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  expenseType   ExpenseType
  description   String
  amount        Decimal     @db.Decimal(12, 2)
  paidBy        String
  isRecoverable Boolean     @default(false)
  isRecovered   Boolean     @default(false)
  notes         String?
  receiptUrl    String?
  createdAt     DateTime    @default(now())

  firmId   String
  matterId String?
  clientId String?

  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter Matter? @relation(fields: [matterId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@index([firmId, date])
  @@index([firmId, matterId])
  @@map("expenses")
}

// ─────────────────────────────────────────────
// DOCUMENT
// ─────────────────────────────────────────────

model Document {
  id          String           @id @default(cuid())
  name        String
  category    DocumentCategory @default(miscellaneous)
  fileType    String
  fileSize    String
  fileUrl     String?
  description String?
  tags        String[]
  uploadedAt  DateTime         @default(now())

  firmId       String
  matterId     String?
  clientId     String?
  uploadedById String

  firm       Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter     Matter? @relation(fields: [matterId], references: [id])
  client     Client? @relation(fields: [clientId], references: [id])
  uploadedBy User    @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([firmId, matterId])
  @@index([firmId, uploadedAt])
  @@map("documents")
}

// ─────────────────────────────────────────────
// TASK
// ─────────────────────────────────────────────

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?    @db.Date
  priority    TaskPriority @default(medium)
  status      TaskStatus   @default(pending)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  firmId     String
  assignedTo String
  assignedBy String
  matterId   String?
  clientId   String?

  firm     Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  assignee User    @relation("AssignedToUser", fields: [assignedTo], references: [id])
  assigner User    @relation("AssignedByUser", fields: [assignedBy], references: [id])
  matter   Matter? @relation(fields: [matterId], references: [id])
  client   Client? @relation(fields: [clientId], references: [id])

  @@index([firmId, status])
  @@index([firmId, assignedTo])
  @@index([firmId, matterId])
  @@map("tasks")
}

// ─────────────────────────────────────────────
// REMINDER
// ─────────────────────────────────────────────

model Reminder {
  id          String          @id @default(cuid())
  type        ReminderType
  title       String
  message     String
  scheduledAt DateTime
  status      ReminderStatus  @default(pending)
  sentAt      DateTime?
  channel     ReminderChannel @default(internal)
  createdAt   DateTime        @default(now())

  firmId   String
  clientId String?
  matterId String?

  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id])
  matter Matter? @relation(fields: [matterId], references: [id])

  @@index([firmId, status, scheduledAt])
  @@map("reminders")
}

// ─────────────────────────────────────────────
// TIMELINE
// ─────────────────────────────────────────────

model TimelineEntry {
  id          String            @id @default(cuid())
  entityType  String
  entityId    String
  type        TimelineEventType
  title       String
  description String?
  userName    String
  createdAt   DateTime          @default(now())

  firmId   String
  userId   String
  matterId String?
  clientId String?

  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id])
  matter Matter? @relation(fields: [matterId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@index([firmId, entityId, createdAt])
  @@map("timeline_entries")
}

// ─────────────────────────────────────────────
// REMINDER TEMPLATE
// ─────────────────────────────────────────────

model ReminderTemplate {
  id       String       @id @default(cuid())
  name     String
  type     ReminderType
  template String

  firmId String

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@map("reminder_templates")
}

// ─────────────────────────────────────────────
// OFFICE SETTINGS
// ─────────────────────────────────────────────

model OfficeSettings {
  id               String   @id @default(cuid())
  officeName       String
  advocateName     String
  barCouncilNumber String
  address          String
  city             String
  state            String
  phone            String
  email            String
  website          String?
  gstin            String?
  panNumber        String?
  logo             String?
  updatedAt        DateTime @updatedAt

  firmId String @unique

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@map("office_settings")
}

// ─────────────────────────────────────────────
// COURT REGISTRY (shared master data)
// ─────────────────────────────────────────────

model CourtRegistry {
  id       String     @id @default(cuid())
  name     String
  level    CourtLevel
  location String
  state    String

  @@map("court_registry")
}

// ─────────────────────────────────────────────
// CASE TYPES (per firm, customizable)
// ─────────────────────────────────────────────

model CaseType {
  id     String @id @default(cuid())
  name   String
  firmId String

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, name])
  @@map("case_types")
}
